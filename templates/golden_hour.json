{
  "id": "golden_hour",
  "name": "Golden Hour",
  "category": "Beach",
  "color": "#E17055",
  "description": "Warm tones and slow dissolves.",
  "maxClips": 5,
  
  "scene_pack": {
    "lut": "golden_hour.cube",
    "transitions": ["dissolve"],
    "overlays": [],
    "sharpness": 1.0,
    "vignette": 4.0
  },

  "story_intent": {
    "slots": [
      { "type": "wide", "duration": 10.0, "trimStart": 1.0 },
      { "type": "detail", "duration": 10.0 },
      { "type": "action", "duration": 2.0, "speed": 1.5 }
    ]
  },

  "output_pace": {
    "bpm": 120,
    "beatMarkers": [0.5, 1.0, 1.5],
    "targetDuration": 15,
    "cutStyle": "on_beat"
  },

  "processing": {
    "fps": 30,
    "width": 1080,
    "height": 1920,
    "transition": {
      "type": "fade",
      "duration": 0.8
    },
    "cinematicBars": false,
    "textOverlays": [
      {
        "text": "BALI 2026",
        "start": 0.5,
        "end": 3.5,
        "fontSize": 64,
        "color": "white",
        "x": "(w-text_w)/2",
        "y": "h/2"
      }
    ]
  }
}